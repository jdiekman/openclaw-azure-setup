# Accelerate OpenClaw Agent — Environment Variables
# Copy to .env and fill in values as you progress through Setup.md.txt
# NEVER commit the .env file — it's in .gitignore

# Phase 1: Azure VM
VM_PUBLIC_IP=
VM_SSH_KEY_PATH=~/.ssh/id_rsa

# Phase 3: Entra ID Agent User
AGENT_UPN=<AGENT_EMAIL>
AGENT_PASSWORD=

# Phase 4: App Registration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Phase 5: SharePoint
SHAREPOINT_SITE_ID=

# Phase 6: Azure Bot
BOT_APP_ID=

# Phase 7: DNS
AGENT_DOMAIN=<AGENT_DOMAIN>

# Phase 8: OpenClaw
ANTHROPIC_API_KEY=

# Meeting Service: ACS + Speech
ACS_CONNECTION_STRING=
ACS_ENDPOINT=
SPEECH_KEY=
SPEECH_REGION=australiaeast

# Phase 10: GitHub Actions
DEPLOYMENT_SP_CLIENT_ID=
DEPLOYMENT_SP_TENANT_ID=
DEPLOYMENT_SP_SUBSCRIPTION_ID=